{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REFLECT DODGE",
  "version": "0.2.0",
  "identifier": "com.mikeylambo.reflectdodge",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "REFLECT / DODGE", "width": 1280, "height": 720, "minWidth": 960, "minHeight": 540, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
